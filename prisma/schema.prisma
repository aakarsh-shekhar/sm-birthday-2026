// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  swipes         Swipe[]
  foodSelections FoodSelection[]
  groceryNote    GroceryNote?
  groceryItems   GroceryItem[]
  easterEggFinds EasterEggFind[]
}

model EasterEggFind {
  id            String      @id @default(cuid())
  participantId String
  eggKey        String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, eggKey])
}

model Activity {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String?
  imageUrl       String?
  activityUrl    String?
  includedInStay Boolean?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  swipes         Swipe[]
}

model Swipe {
  id            String    @id @default(cuid())
  participantId String
  activityId    String
  reaction      Reaction
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  activity      Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([participantId, activityId])
}

model FoodOption {
  id          String          @id @default(cuid())
  title       String
  description String?
  infoUrl     String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  selections  FoodSelection[]
}

model FoodSelection {
  id            String      @id @default(cuid())
  participantId String
  foodOptionId  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  foodOption    FoodOption  @relation(fields: [foodOptionId], references: [id], onDelete: Cascade)

  @@unique([participantId, foodOptionId])
}

model GroceryNote {
  id            String      @id @default(cuid())
  participantId String      @unique
  note          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model GroceryItem {
  id            String      @id @default(cuid())
  participantId String
  item          String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

enum Reaction {
  PASS
  LIKE
  SUPERLIKE
}
